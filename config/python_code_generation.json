{
  "config_version": 1,
  "phase": "single_operation_capability",
  "input": "data/train_semantic_asts.jsonl",
  "output": "data/python_code_candidates.jsonl",
  "rejections": "data/rejected_python_codes.jsonl",
  "stats": "data/python_code_generation_stats.json",
  "operation_count_filter": 1,
  "target_verified_per_ast": 20,
  "generator_version": "1",
  "generator_seed": 0,
  "element_names": [
    "x",
    "value"
  ],
  "result_names": [
    "result",
    "output"
  ],
  "max_source_chars": 4096,
  "verification": {
    "reference": "reference_interpreter.py",
    "boundary_case_count": 9,
    "random_case_count": 32,
    "random_seed": 0,
    "timeout_seconds": 5.0,
    "require_input_unchanged": true
  },
  "exact_duplicate_check": {
    "lookup": "sha256",
    "final_comparison": "full_reference_code"
  },
  "python": {
    "version": "3.12",
    "lockfile": "uv.lock"
  }
}
